# mochy-navidrome-module environment configuration
# All settings are optional; defaults are shown below.

# HTTP listening port
# PORT=8090

# Optional: Upstream Navidrome server URL (e.g. https://music.example.com or http://192.168.1.100:4533)
# If unset, the module probes http://navidrome:4533 on startup for Docker network discovery.
# NAVIDROME_URL=

# Optional: Public base URL when deployed behind a reverse proxy (e.g. https://music-module.example.com)
# Defaults to the incoming request Host header if left empty.
# PUBLIC_URL=

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Log format: text, json (default: text)
# LOG_FORMAT=text

# Optional: Unique Module ID and display name in Mochy Music (for single-server mode)
# MODULE_ID=mochy-navidrome
# MODULE_NAME=Navidrome

# Optional: Serve multiple Navidrome servers from a single container via path prefixes
# Syntax: slug:Name:URL,slug2:Name2:URL2
# Each server gets its own manifest at /<slug>/manifest.json in Mochy Music
# SERVERS=music:Navidrome:https://music.example.com,dolby:Navidrome (Dolby):https://dolby.example.com
